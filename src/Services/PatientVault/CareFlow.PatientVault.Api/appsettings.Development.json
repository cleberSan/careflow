{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PatientVault": "Host=localhost;Port=5432;Database=careflow_vault;Username=vault_api",
    "PatientVaultMigrations": "Host=localhost;Port=5432;Database=careflow_vault;Username=careflow",
    "PatientVaultRelay": "Host=localhost;Port=5432;Database=careflow_vault;Username=vault_dispatcher",
    "RabbitMq": "amqp://careflow:careflow-dev@localhost:5672/"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "KeyManagement": {
    "Provider": "Local",
    "Local": {
      "ActiveKeyId": "dev-1"
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5124",
          "https://localhost:7087"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}