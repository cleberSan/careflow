{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Notifications": "Host=localhost;Port=5432;Database=careflow_notifications;Username=notifications_api",
    "NotificationsMigrations": "Host=localhost;Port=5432;Database=careflow_notifications;Username=careflow",
    "NotificationsRelay": "Host=localhost;Port=5432;Database=careflow_notifications;Username=notifications_dispatcher",
    "RabbitMq": "amqp://careflow:careflow-dev@localhost:5672/"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Vault": {
    "BaseAddress": "https://localhost:7087/"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5154",
          "https://localhost:7117",
          "careflow-notifications"
        ],
        "ValidIssuer": "dotnet-user-jwts",
        "ValidIssuers": [
          "careflow-demo-local"
        ]
      }
    }
  },
  "FaultInjection": {
    "Enabled": false,
    "Channels": {
      "whatsapp": {
        "Mode": "None"
      },
      "sms": {
        "Mode": "None"
      },
      "email": {
        "Mode": "None"
      }
    }
  }
}
