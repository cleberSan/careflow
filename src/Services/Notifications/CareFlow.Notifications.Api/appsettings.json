{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "",
        "ValidAudiences": ["careflow-notifications"]
      }
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Messaging": {
    "ServiceName": "notifications"
  },
  "Notifications": {
    "DefaultClinicName": "sua clínica",
    "Resilience": {
      "AttemptTimeout": "00:00:03",
      "TotalTimeout": "00:00:15",
      "MaxRetryAttempts": 2,
      "RetryBaseDelay": "00:00:00.200",
      "FailureRatio": 0.5,
      "MinimumThroughput": 6,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:30"
    }
  },
  "FaultInjection": {
    "Enabled": false
  }
}
