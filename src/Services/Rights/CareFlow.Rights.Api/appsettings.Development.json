{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Rights": "Host=localhost;Port=5432;Database=careflow_rights;Username=rights_api",
    "RightsMigrations": "Host=localhost;Port=5432;Database=careflow_rights;Username=careflow",
    "RightsRelay": "Host=localhost;Port=5432;Database=careflow_rights;Username=rights_dispatcher",
    "RabbitMq": "amqp://careflow:careflow-dev@localhost:5672/"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5174",
          "https://localhost:7137",
          "careflow-rights"
        ],
        "ValidIssuer": "dotnet-user-jwts",
        "ValidIssuers": [
          "careflow-demo-local"
        ]
      }
    }
  }
}
