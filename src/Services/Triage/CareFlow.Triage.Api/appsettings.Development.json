{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Triage": "Host=localhost;Port=5432;Database=careflow_triage;Username=triage_api",
    "TriageMigrations": "Host=localhost;Port=5432;Database=careflow_triage;Username=careflow",
    "TriageRelay": "Host=localhost;Port=5432;Database=careflow_triage;Username=triage_dispatcher",
    "RabbitMq": "amqp://careflow:careflow-dev@localhost:5672/"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Vault": {
    "BaseAddress": "https://localhost:7087/"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5164",
          "https://localhost:7127",
          "careflow-triage"
        ],
        "ValidIssuer": "dotnet-user-jwts",
        "ValidIssuers": [
          "careflow-demo-local"
        ]
      }
    }
  }
}
