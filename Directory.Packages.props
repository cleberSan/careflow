<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="FHIR">
    <!-- Firely SDK (BSD-3-Clause): Bundle FHIR R4 no serviço de pedidos do titular; validação só nos testes (ADR-0012). -->
    <PackageVersion Include="Hl7.Fhir.R4" Version="6.8.0" />
    <PackageVersion Include="Hl7.Fhir.Specification.Data.R4" Version="6.7.0" />
    <PackageVersion Include="Firely.Fhir.Validation.R4" Version="3.5.0" />
  </ItemGroup>
  <ItemGroup Label="IA">
    <!-- SDK oficial da Anthropic (MIT), só no serviço de triagem (ADR-0011). -->
    <PackageVersion Include="Anthropic" Version="12.57.0" />
  </ItemGroup>
  <ItemGroup Label="Chaves">
    <!-- SDK da Oracle (UPL 1.0 / Apache 2.0), só no cofre: chave mestra no OCI Vault na demonstração hospedada (ADR-0013). -->
    <PackageVersion Include="OCI.DotNetSDK.Keymanagement" Version="147.1.0" />
    <!-- Transitiva do SDK da Oracle, fixada acima da 12.0.3 (GHSA-5crp-9r3c-p9vr). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Label="Persistência">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Mensageria">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup Label="Observabilidade">
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
