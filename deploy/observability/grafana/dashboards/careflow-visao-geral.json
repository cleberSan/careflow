    {
      "id": 9,
      "type": "stat",
      "title": "Mensagens mortas por fila",
      "description": "Qualquer valor acima de zero pede investigação: a mensagem esgotou as entregas ou é inválida.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
