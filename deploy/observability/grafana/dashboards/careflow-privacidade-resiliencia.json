    {
      "id": 8,
      "type": "stat",
      "title": "Estado do circuit breaker (circuito compartilhado)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (channel) (careflow_notifications_circuit_state{partition=\"shared\"})",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fechado",
                  "color": "green"
                },
                "1": {
                  "text": "meio-aberto",
                  "color": "yellow"
                },
                "2": {
                  "text": "aberto",
                  "color": "red"
                },
                "3": {
                  "text": "isolado",
                  "color": "purple"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Estado do circuit breaker ao longo do tempo",
      "description": "0 fechado, 1 meio-aberto, 2 aberto, 3 isolado. Partição isolated-NN é uma clínica do demo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
