        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel) (rate(careflow_notifications_sent_total[5m]))",
          "legendFormat": "{{channel}}"
        }
