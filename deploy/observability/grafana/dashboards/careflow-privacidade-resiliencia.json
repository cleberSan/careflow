{
  "uid": "careflow-privacidade-resiliencia",
  "title": "CareFlow · Privacidade e resiliência",
  "description": "Propagação da revogação de consentimento, envios e fallbacks por canal e estado do circuit breaker. Nenhum rótulo carrega clínica ou paciente. ADR-0010.",
  "tags": [
    "careflow",
    "fase-6"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Revogação de consentimento",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tempo de propagação da revogação (p50, p95, p99)",
      "description": "Da revogação gravada no Consent ao efeito confirmado na agenda (consultas canceladas) e no Notifications.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, consumer) (rate(careflow_messaging_delivery_lag_seconds_bucket{event_type=\"consent.revoked\"}[5m])))",
          "legendFormat": "p50 até {{consumer}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, consumer) (rate(careflow_messaging_delivery_lag_seconds_bucket{event_type=\"consent.revoked\"}[5m])))",
          "legendFormat": "p95 até {{consumer}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, consumer) (rate(careflow_messaging_delivery_lag_seconds_bucket{event_type=\"consent.revoked\"}[5m])))",
          "legendFormat": "p99 até {{consumer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Revogações processadas (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (increase(careflow_messaging_inbox_processed_total{event_type=\"consent.revoked\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "row",
      "title": "Canais de aviso",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
