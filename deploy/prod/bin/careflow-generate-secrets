#!/usr/bin/env bash
# Gera, na própria VM, todas as senhas e chaves da demonstração hospedada (ADR-0013) em /etc/careflow/env.
# Nada sai da VM e nada vai para o repositório. Os arquivos ficam com dono root e modo 0600; o Docker lê como root.
#
# Uso (como root, uma vez, depois do cloud-init):
#   careflow-generate-secrets --vault-endpoint <crypto endpoint do OCI Vault> --key-id <OCID da chave>
#
# Rodar de novo não troca nada: perder a chave da auditoria ou a do Rights torna ilegível o que já foi gravado.
# Para começar do zero de propósito: pare a stack, apague os volumes e /etc/careflow/env, e rode de novo.
# Para trocar só o endpoint ou a chave do OCI Vault: --update-vault com os dois argumentos.
set -euo pipefail
umask 077

ENV_DIR="${CAREFLOW_ENV_DIR:-/etc/careflow/env}"
vault_endpoint=""
key_id=""
update_vault=false

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --vault-endpoint) vault_endpoint="${2:-}"; shift 2 ;;
    --key-id) key_id="${2:-}"; shift 2 ;;
    --update-vault) update_vault=true; shift ;;
    -h|--help) usage ;;
    *) echo "Argumento desconhecido: $1" >&2; usage ;;
  esac
done

if [[ "${CAREFLOW_ENV_DIR:-}" == "" && "$(id -u)" -ne 0 ]]; then
  echo "Rode como root (sudo)." >&2
  exit 1
fi

# Os dois valores não são segredo, mas são da conta do Cleber: vêm por argumento, nunca do repositório.
if [[ ! "$vault_endpoint" =~ ^https://[a-z0-9.-]+\.oraclecloud\.com/?$ ]]; then
  echo "--vault-endpoint precisa ser o Cryptographic endpoint do vault (https://...oraclecloud.com)." >&2
  exit 1
fi
if [[ ! "$key_id" =~ ^ocid1\.key\.[a-z0-9._-]+$ ]]; then
  echo "--key-id precisa ser o OCID da chave (ocid1.key...)." >&2
  exit 1
fi

write_vault_settings() {
  local file="$1"
  grep -v '^KeyManagement__OciVault__' "$file" > "$file.tmp" || true
  {
    echo "KeyManagement__OciVault__CryptoEndpoint=${vault_endpoint%/}"
    echo "KeyManagement__OciVault__KeyId=${key_id}"
  } >> "$file.tmp"
  mv "$file.tmp" "$file"
}

if [[ "$update_vault" == true ]]; then
  [[ -f "$ENV_DIR/patient-vault.env" ]] || { echo "Ainda não há segredos gerados em $ENV_DIR." >&2; exit 1; }
  write_vault_settings "$ENV_DIR/patient-vault.env"
  echo "Endpoint e chave do OCI Vault atualizados. Rode: careflow-deploy redeploy"
  exit 0
fi

if [[ -e "$ENV_DIR/.generated" ]]; then
  echo "Os segredos já existem em $ENV_DIR e não foram tocados."
  exit 0
fi
if [[ -d "$ENV_DIR" ]] && [[ -n "$(ls -A "$ENV_DIR" 2>/dev/null)" ]]; then
  echo "$ENV_DIR tem arquivos, mas não o marcador .generated: geração anterior incompleta. Confira e apague a pasta antes." >&2
  exit 1
fi

# Tudo é gerado num temporário na mesma partição e só vira definitivo no fim, de uma vez.
mkdir -p "$(dirname "$ENV_DIR")"
work="$(mktemp -d "$(dirname "$ENV_DIR")/.env-XXXXXX")"
trap 'rm -rf "$work"' EXIT

password() { openssl rand -hex 24; }
key32() { openssl rand -base64 32; }

# Par P-256: privada em PKCS#8 DER e pública em SubjectPublicKeyInfo DER, as duas em Base64 numa linha.
p256_pair() {
  local pem="$work/pair.pem"
  openssl ecparam -name prime256v1 -genkey -noout -out "$pem"
  PRIVATE="$(openssl pkcs8 -topk8 -nocrypt -in "$pem" -outform DER | base64 -w0)"
  PUBLIC="$(openssl ec -in "$pem" -pubout -outform DER 2>/dev/null | base64 -w0)"
  rm -f "$pem"
}

superuser_password="$(password)"
rabbit_password="$(password)"
demo_signing_key="$(key32)"
declare -A owner api dispatcher
for service in scheduling vault consent audit notifications triage rights; do
  owner[$service]="$(password)"
  api[$service]="$(password)"
  dispatcher[$service]="$(password)"
done

p256_pair; notifications_service_private="$PRIVATE"; notifications_service_public="$PUBLIC"
p256_pair; triage_service_private="$PRIVATE"; triage_service_public="$PUBLIC"
p256_pair; identity_private="$PRIVATE"; identity_public="$PUBLIC"

# Banco e broker.
{
  echo "POSTGRES_PASSWORD=$superuser_password"
  for service in scheduling vault consent audit notifications triage rights; do
    upper="${service^^}"
    echo "CAREFLOW_${upper}_OWNER_PASSWORD=${owner[$service]}"
    echo "CAREFLOW_${upper}_API_PASSWORD=${api[$service]}"
    echo "CAREFLOW_${upper}_DISPATCHER_PASSWORD=${dispatcher[$service]}"
  done
} > "$work/postgres.env"

{
  echo "RABBITMQ_DEFAULT_USER=careflow"
  echo "RABBITMQ_DEFAULT_PASS=$rabbit_password"
} > "$work/rabbitmq.env"

# Comum aos sete serviços de domínio: broker e a chave que valida os tokens curtos emitidos pelo Demo.
{
  echo "ConnectionStrings__RabbitMq=amqp://careflow:${rabbit_password}@rabbitmq:5672/"
  echo "Authentication__Schemes__Bearer__SigningKeys__0__Issuer=careflow-demo-hosted"
  echo "Authentication__Schemes__Bearer__SigningKeys__0__Value=$demo_signing_key"
} > "$work/common.env"

# Conexões de cada serviço: API e despachante (sujeitos ao RLS) e o dono do banco, que roda as migrations e a limpeza
# das clínicas do Painel. Nenhum serviço recebe o superusuário.
connection() {
  local name="$1" database="$2" role="$3"
  echo "ConnectionStrings__${name}Migrations=Host=postgres;Port=5432;Database=${database};Username=${role}_owner;Password=${owner[$role]}"
  echo "ConnectionStrings__${name}=Host=postgres;Port=5432;Database=${database};Username=${role}_api;Password=${api[$role]}"
  echo "ConnectionStrings__${name}Relay=Host=postgres;Port=5432;Database=${database};Username=${role}_dispatcher;Password=${dispatcher[$role]}"
}

{
  connection PatientVault careflow_vault vault
  # Cada serviço que lê o cofre tem o próprio par: Notifications (contato) e Triage (perfil de mascaramento).
  echo "InternalAuth__PublicKey=$notifications_service_public"
  echo "InternalAuth__AdditionalPublicKeys__0=$triage_service_public"
} > "$work/patient-vault.env"
write_vault_settings "$work/patient-vault.env"

connection Consent careflow_consent consent > "$work/consent.env"
connection Scheduling careflow_scheduling scheduling > "$work/scheduling.env"

audit_key_id="demo-$(date -u +%Y%m)"
{
  connection Audit careflow_audit audit
  echo "Audit__Chain__ActiveKeyId=$audit_key_id"
  echo "Audit__Chain__Keys__${audit_key_id}=$(key32)"
} > "$work/audit.env"

{
  connection Notifications careflow_notifications notifications
  echo "ServiceTokens__Local__PrivateKey=$notifications_service_private"
  echo "IdentityVerification__PrivateKey=$identity_private"
} > "$work/notifications.env"

{
  connection Triage careflow_triage triage
  echo "ServiceTokens__Local__PrivateKey=$triage_service_private"
} > "$work/triage.env"

{
  connection Rights careflow_rights rights
  echo "Rights__Keys__KeyEncryptionKey=$(key32)"
  echo "IdentityVerification__NotificationsPublicKey=$identity_public"
} > "$work/rights.env"

echo "Demo__Tokens__SigningKey=$demo_signing_key" > "$work/demo.env"

{
  echo "GF_SECURITY_ADMIN_USER=cleber"
  echo "GF_SECURITY_ADMIN_PASSWORD=$(password)"
} > "$work/grafana.env"

date -u +%Y-%m-%dT%H:%M:%SZ > "$work/.generated"
chmod 0600 "$work"/*.env "$work/.generated"
chmod 0700 "$work"
rm -rf "$ENV_DIR"
mv "$work" "$ENV_DIR"
trap - EXIT

echo "Segredos gerados em $ENV_DIR (root, 0600). Nenhum valor foi impresso."
echo "Senha do Grafana, quando precisar: sudo grep GF_SECURITY_ADMIN_PASSWORD $ENV_DIR/grafana.env"
