<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Teste de fumaça da demonstração hospedada (ADR-0013): roda contra a URL pública depois de cada deploy.
    Sem CAREFLOW_SMOKE_URL os testes são pulados, então ele pode ficar na solução sem subir nada no CI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
